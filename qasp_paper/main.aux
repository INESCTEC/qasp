\citation{mcclean2018barren}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Finite-size concentration experiment generated by the executable barren-plateau notebook. Each point uses 128 independent $\operatorname  {Unif}[-\pi ,\pi ]$ parameter initializations, a fixed zero input, a one-layer chain ansatz, and global $Z^{\otimes n}$ readout. The raw expectation variance has fitted slope $-1.11$ per qubit on a base-two logarithmic scale over $n=2,\ldots  ,10$. This cost-concentration example validates the width-sweep workflow; it is not, by itself, a claim about gradient-variance scaling.}}{57}{figure.caption.47}\protected@file@percent }
\newlabel{fig:barren-plateau-width-sweep}{{21}{57}{Finite-size concentration experiment generated by the executable barren-plateau notebook. Each point uses 128 independent $\operatorname {Unif}[-\pi ,\pi ]$ parameter initializations, a fixed zero input, a one-layer chain ansatz, and global $Z^{\otimes n}$ readout. The raw expectation variance has fitted slope $-1.11$ per qubit on a base-two logarithmic scale over $n=2,\ldots ,10$. This cost-concentration example validates the width-sweep workflow; it is not, by itself, a claim about gradient-variance scaling}{figure.caption.47}{}}
\newlabel{fig:barren-plateau-width-sweep@cref}{{[figure][21][]21}{[1][57][]57}}
